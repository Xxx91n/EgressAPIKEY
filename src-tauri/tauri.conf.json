{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EgressAPIKEY",
  "version": "0.2.0",
  "identifier": "com.egressapikey.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "EgressAPIKEY",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' http://127.0.0.1:7897 http://127.0.0.1:9090 http://localhost:1420 ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "frame-ancestors": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "EgressAPIKEY — AI API key exit-IP proxy pool",
    "longDescription": "Multi-port socks5/http forwarder between AI gateways (omniroute/litellm) and upstream v1 providers, with per-port key identity and exit-IP routing via a bundled Resin sidecar.",
    "externalBin": [
      "binaries/resin"
    ]
  }
}
