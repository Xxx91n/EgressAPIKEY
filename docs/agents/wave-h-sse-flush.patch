+func TestIsEventStreamContentType(t *testing.T) {
+	t.Run("Bare", func(t *testing.T) {
+		if !isEventStreamContentType("text/event-stream") {
+			t.Fatal("bare text/event-stream should be detected")
+		}
+	})
+
+	t.Run("WithParameters", func(t *testing.T) {
+		if !isEventStreamContentType("text/event-stream; charset=utf-8") {
+			t.Fatal("parameterized text/event-stream should be detected")
+		}
+	})
+
+	t.Run("CaseInsensitive", func(t *testing.T) {
+		if !isEventStreamContentType("Text/Event-Stream") {
+			t.Fatal("media type matching should be case-insensitive")
+		}
+	})
+
+	t.Run("Empty", func(t *testing.T) {
+		if isEventStreamContentType("") {
+			t.Fatal("empty Content-Type should not be detected as SSE")
+		}
+	})
+
+	t.Run("NonSSE", func(t *testing.T) {
+		if isEventStreamContentType("application/octet-stream") {
+			t.Fatal("binary content should not be detected as SSE")
+		}
+	})
+}
