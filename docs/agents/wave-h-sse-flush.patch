+func TestCopyForwardResponseBody_NonSSEUnchanged(t *testing.T) {
+	payload := bytes.Repeat([]byte("binary-chunk-"), 512) // >4KB, multi-read
+	resp := &http.Response{
+		Header: http.Header{"Content-Type": []string{"application/octet-stream"}},
+		Body:   io.NopCloser(bytes.NewReader(payload)),
+	}
+	w := &flushLogWriter{}
+	n, err := copyForwardResponseBody(w, resp)
+	if err != nil {
+		t.Fatalf("copy failed: %v", err)
+	}
+	if n != int64(len(payload)) {
+		t.Fatalf("copied %d bytes, want %d", n, len(payload))
+	}
+	for _, entry := range w.logf {
+		if entry == "flush" {
+			t.Fatal("non-SSE response must not flush; plain io.Copy path expected")
+		}
+	}
+	var got bytes.Buffer
+	for _, entry := range w.logf {
+		got.WriteString(entry[len("write:"):])
+	}
+	if !bytes.Equal(got.Bytes(), payload) {
+		t.Fatal("non-SSE body bytes differ from upstream payload")
+	}
+}
+
+// noFlushWriter deliberately does not implement http.Flusher.
+type noFlushWriter struct {
+	header http.Header
+	buf    bytes.Buffer
+}
+
+func (w *noFlushWriter) Header() http.Header {
+	if w.header == nil {
+		w.header = http.Header{}
+	}
+	return w.header
+}
+
+func (w *noFlushWriter) WriteHeader(int) {}
+
+func (w *noFlushWriter) Write(p []byte) (int, error) { return w.buf.Write(p) }
+
+func TestCopyForwardResponseBody_SSEWithoutFlusherStillCopies(t *testing.T) {
+	body := "data: fallback-1\n\ndata: fallback-2\n\n"
+	resp := &http.Response{
+		Header: http.Header{"Content-Type": []string{"text/event-stream"}},
+		Body:   io.NopCloser(bytes.NewBufferString(body)),
+	}
+	w := &noFlushWriter{}
+	n, err := copyForwardResponseBody(w, resp)
+	if err != nil {
+		t.Fatalf("copy failed: %v", err)
+	}
+	if n != int64(len(body)) || w.buf.String() != body {
+		t.Fatal("SSE body without Flusher support must still be copied verbatim")
+	}
+}
