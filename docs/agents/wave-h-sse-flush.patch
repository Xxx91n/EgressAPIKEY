+// TestCopyForwardResponseBody_SSEEventArrivesBeforeStreamEnds is the per-event
+// arrival assertion: the first SSE event must reach the client while the
+// upstream body is still open and has not produced the second event. Under a
+// plain io.Copy(w, body) the first event (well under 4KB) would sit in the
+// server's write buffer until the handler returns, so this read would time
+// out.
+func TestCopyForwardResponseBody_SSEEventArrivesBeforeStreamEnds(t *testing.T) {
+	release := make(chan struct{})
+	resp := &http.Response{
+		Header: http.Header{"Content-Type": []string{"text/event-stream; charset=utf-8"}},
+		Body: io.NopCloser(&stepReader{
+			steps:   [][]byte{[]byte("data: event-1\n\n"), []byte("data: event-2\n\n")},
+			release: release,
+		}),
+	}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if _, err := copyForwardResponseBody(w, resp); err != nil {
+			t.Errorf("copy failed: %v", err)
+		}
+	}))
+	defer srv.Close()
+
+	httpResp, err := http.Get(srv.URL)
+	if err != nil {
+		t.Fatalf("get: %v", err)
+	}
+	defer httpResp.Body.Close()
+
+	reader := bufio.NewReader(httpResp.Body)
+	readWithTimeout := func(n int) (string, error) {
+		type result struct {
+			s   string
+			err error
+		}
+		done := make(chan result, 1)
+		go func() {
+			buf := make([]byte, n)
+			m, err := io.ReadFull(reader, buf)
+			done <- result{string(buf[:m]), err}
+		}()
+		select {
+		case res := <-done:
+			return res.s, res.err
+		case <-time.After(3 * time.Second):
+			return "", errors.New("read timed out")
+		}
+	}
+
+	event1 := "data: event-1\n\n"
+	got, err := readWithTimeout(len(event1))
+	if err != nil {
+		t.Fatalf("first SSE event did not arrive while stream still open: %v", err)
+	}
+	if got != event1 {
+		t.Fatalf("first event = %q, want %q", got, event1)
+	}
+
+	close(release)
+	event2 := "data: event-2\n\n"
+	got, err = readWithTimeout(len(event2))
+	if err != nil {
+		t.Fatalf("second SSE event: %v", err)
+	}
+	if got != event2 {
+		t.Fatalf("second event = %q, want %q", got, event2)
+	}
+}
