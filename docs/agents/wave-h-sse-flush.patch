+// stepReader emits one chunk per Read. Before the second chunk it blocks on
+// release (when non-nil) so a test can prove the first event was already
+// delivered while the upstream stream is still open.
+type stepReader struct {
+	steps   [][]byte
+	release chan struct{}
+	i       int
+}
+
+func (r *stepReader) Read(p []byte) (int, error) {
+	if r.i >= len(r.steps) {
+		return 0, io.EOF
+	}
+	if r.i == 1 && r.release != nil {
+		<-r.release
+	}
+	n := copy(p, r.steps[r.i])
+	r.i++
+	return n, nil
+}
+
+// flushLogWriter records the interleaving of Write and Flush calls.
+type flushLogWriter struct {
+	header http.Header
+	logf   []string
+}
+
+func (w *flushLogWriter) Header() http.Header {
+	if w.header == nil {
+		w.header = http.Header{}
+	}
+	return w.header
+}
+
+func (w *flushLogWriter) WriteHeader(int) {}
+
+func (w *flushLogWriter) Write(p []byte) (int, error) {
+	w.logf = append(w.logf, "write:"+string(p))
+	return len(p), nil
+}
+
+func (w *flushLogWriter) Flush() {
+	w.logf = append(w.logf, "flush")
+}
+
+func TestCopyForwardResponseBody_SSEFlushesAfterEveryWrite(t *testing.T) {
+	resp := &http.Response{
+		Header: http.Header{"Content-Type": []string{"text/event-stream"}},
+		Body: io.NopCloser(&stepReader{steps: [][]byte{
+			[]byte("data: event-1\n\n"),
+			[]byte("data: event-2\n\n"),
+		}}),
+	}
+	w := &flushLogWriter{}
+	n, err := copyForwardResponseBody(w, resp)
+	if err != nil {
+		t.Fatalf("copy failed: %v", err)
+	}
+	if n != int64(len("data: event-1\n\n")+len("data: event-2\n\n")) {
+		t.Fatalf("copied %d bytes", n)
+	}
+	want := []string{
+		"write:data: event-1\n\n", "flush",
+		"write:data: event-2\n\n", "flush",
+	}
+	if len(w.logf) != len(want) {
+		t.Fatalf("log = %v, want %v", w.logf, want)
+	}
+	for i := range want {
+		if w.logf[i] != want[i] {
+			t.Fatalf("log[%d] = %q, want %q (full log %v)", i, w.logf[i], want[i], w.logf)
+		}
+	}
+}
