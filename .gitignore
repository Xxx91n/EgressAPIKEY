# dependencies
node_modules/
dist/
# typescript incremental build cache
*.tsbuildinfo
tsconfig.tsbuildinfo
# tsc project references may also produce these side-products; do not commit
vite.config.d.ts
vite.config.js
# pnpm may auto-create this workspace file; not used here
pnpm-workspace.yaml
dist-ssr/
target/

# tauri
src-tauri/target/
src-tauri/gen/
src-tauri/sidecar/*
!src-tauri/sidecar/.keep

# resin sidecar binary staging: the resin-<triple>.(exe|) binaries are
# fetched per-platform by scripts/fetch_resin.{ps1,sh} at build/CI time
# from the published Resin GitHub release matching the host triple. We do
# NOT commit the ~38MB per-platform Go binary: that would bloat the repo
# history and the binaries are identical upstream releases, just renamed
# to the target triple Tauri expects.
src-tauri/binaries/*.zip
src-tauri/binaries/_tmp_win/
src-tauri/binaries/_version*.txt
src-tauri/binaries/resin*
!src-tauri/binaries/.gitkeep

# local data
*.sqlite
*.sqlite3
*.db

# logs
*.log
.omx/

# temp
.codex-tmp/

# secrets & env
.env
.env.*
*.pem
*.key
!*.pub

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# tauri build artifacts
src-tauri/gen/
src-tauri/icons/
!src-tauri/icons/*.png
!src-tauri/icons/*.icns
!src-tauri/icons/*.ico

# rust toolchain
.cargo/*
!.cargo/config.toml
rust-toolchain.toml

# codegraph
.codegraph/
# release artifacts
release/

# playwright
playwright-report/
test-results/
.playwright/
.codex-tmp/

# session-local artifacts (context-mode plugin)
.npmrc
context-mode/
